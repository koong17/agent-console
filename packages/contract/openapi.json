    "/ingest/status": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "current",
                    "recent"
                  ],
                  "properties": {
                    "current": {
                      "anyOf": [
                        {
                          "type": "object",
