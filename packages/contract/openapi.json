{
  "openapi": "3.0.3",
  "info": {
    "title": "agent-console",
    "version": "0.1.0"
  },
  "components": {
    "schemas": {}
  },
  "paths": {
    "/traces": {
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 100
            },
            "in": "query",
            "name": "limit",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "requestId",
                      "method",
                      "url",
                      "statusCode",
                      "durationMs",
                      "startedAt"
                    ],
                    "properties": {
                      "id": {
                        "type": "integer"
                      },
                      "requestId": {
                        "type": "string"
                      },
                      "method": {
                        "type": "string"
                      },
                      "url": {
                        "type": "string"
                      },
                      "statusCode": {
                        "type": "integer"
                      },
                      "durationMs": {
                        "type": "integer"
                      },
                      "startedAt": {
                        "type": "string",
                        "format": "date-time"
                      }
                    },
                    "title": "Trace"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/usage/repos": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "repo",
                      "sessions",
                      "turns",
                      "inputTokens",
                      "outputTokens",
                      "costUsd",
                      "lastSeenAt"
                    ],
                    "properties": {
                      "repo": {
                        "type": "string"
                      },
                      "sessions": {
                        "type": "integer"
                      },
                      "turns": {
                        "type": "integer"
                      },
                      "inputTokens": {
                        "type": "integer"
                      },
                      "outputTokens": {
                        "type": "integer"
                      },
                      "costUsd": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "lastSeenAt": {
                        "anyOf": [
                          {
                            "type": "string",
                            "format": "date-time"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/usage/daily": {
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365,
              "default": 30
            },
            "in": "query",
            "name": "days",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "day",
                      "sessions",
                      "turns",
                      "outputTokens",
                      "costUsd"
                    ],
                    "properties": {
                      "day": {
                        "type": "string",
                        "description": "YYYY-MM-DD, Asia/Seoul"
                      },
                      "sessions": {
                        "type": "integer"
                      },
                      "turns": {
                        "type": "integer"
                      },
                      "outputTokens": {
                        "type": "integer"
                      },
                      "costUsd": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/usage/gates": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "nudged",
                    "complied",
                    "rate",
                    "bypassed",
                    "events"
                  ],
                  "properties": {
                    "nudged": {
                      "type": "integer"
                    },
                    "complied": {
                      "type": "integer"
                    },
                    "rate": {
                      "anyOf": [
                        {
                          "type": "number",
                          "description": "0..1, nudged가 0이면 null"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "bypassed": {
                      "type": "integer"
                    },
                    "events": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "sessionId",
                          "repo",
                          "ts",
                          "triggerSkill",
                          "outcome",
                          "complied"
                        ],
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "sessionId": {
                            "type": "string"
                          },
                          "repo": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "ts": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "triggerSkill": {
                            "type": "string"
                          },
                          "outcome": {
                            "anyOf": [
                              {
                                "type": "string",
                                "enum": [
                                  "nudged"
                                ]
                              },
                              {
                                "type": "string",
                                "enum": [
                                  "throttled"
                                ]
                              }
                            ]
                          },
                          "complied": {
                            "type": "boolean"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/usage/skills/weekly": {
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 52,
              "default": 8
            },
            "in": "query",
            "name": "weeks",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "weeks",
                    "rows"
                  ],
                  "properties": {
                    "weeks": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "description": "주 시작 월요일, YYYY-MM-DD, Asia/Seoul"
                      }
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "skill",
                          "counts",
                          "total"
                        ],
                        "properties": {
                          "skill": {
                            "type": "string"
                          },
                          "counts": {
                            "type": "array",
                            "items": {
                              "type": "integer"
                            },
                            "description": "weeks와 같은 길이, 같은 순서"
                          },
                          "total": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sessions": {
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "repo",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "repo",
                      "gitBranch",
                      "startedAt",
                      "lastSeenAt",
                      "turns",
                      "models",
                      "outputTokens",
                      "costUsd"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "repo": {
                        "type": "string"
                      },
                      "gitBranch": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "startedAt": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "lastSeenAt": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "turns": {
                        "type": "integer"
                      },
                      "models": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "outputTokens": {
                        "type": "integer"
                      },
                      "costUsd": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{id}": {
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "session",
                    "turns",
                    "totalCostUsd"
                  ],
                  "properties": {
                    "session": {
                      "type": "object",
                      "required": [
                        "id",
                        "cwd",
                        "repo",
                        "gitBranch",
                        "cliVersion",
                        "startedAt",
                        "lastSeenAt"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "cwd": {
                          "type": "string"
                        },
                        "repo": {
                          "type": "string"
                        },
                        "gitBranch": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "cliVersion": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "startedAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "lastSeenAt": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    },
                    "turns": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "ts",
                          "model",
                          "inputTokens",
                          "cacheReadTokens",
                          "cacheCreationTokens",
                          "outputTokens",
                          "costUsd"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "ts": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "model": {
                            "type": "string"
                          },
                          "inputTokens": {
                            "type": "integer"
                          },
                          "cacheReadTokens": {
                            "type": "integer"
                          },
                          "cacheCreationTokens": {
                            "type": "integer"
                          },
                          "outputTokens": {
                            "type": "integer"
                          },
                          "costUsd": {
                            "anyOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        }
                      }
                    },
                    "totalCostUsd": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/harness/rules": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "thresholds",
                    "rules"
                  ],
                  "properties": {
                    "thresholds": {
                      "type": "object",
                      "required": [
                        "minEvents",
                        "deadMultiplier",
                        "quietMultiplier",
                        "deadFloorDays"
                      ],
                      "properties": {
                        "minEvents": {
                          "type": "integer"
                        },
                        "deadMultiplier": {
                          "type": "number"
                        },
                        "quietMultiplier": {
                          "type": "number"
                        },
                        "deadFloorDays": {
                          "type": "integer"
                        }
                      }
                    },
                    "rules": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "name",
                          "kind",
                          "status",
                          "total",
                          "firstAt",
                          "lastAt",
                          "silenceDays",
                          "medianGapDays"
                        ],
                        "properties": {
                          "name": {
                            "type": "string",
                            "description": "스킬 이름, 또는 \"gate:<trigger>\""
                          },
                          "kind": {
                            "anyOf": [
                              {
                                "type": "string",
                                "enum": [
                                  "skill"
                                ]
                              },
                              {
                                "type": "string",
                                "enum": [
                                  "gate"
                                ]
                              }
                            ]
                          },
                          "status": {
                            "anyOf": [
                              {
                                "type": "string",
                                "enum": [
                                  "dead"
                                ]
                              },
                              {
                                "type": "string",
                                "enum": [
                                  "quiet"
                                ]
                              },
                              {
                                "type": "string",
                                "enum": [
                                  "ok"
                                ]
                              },
                              {
                                "type": "string",
                                "enum": [
                                  "insufficient"
                                ]
                              }
                            ]
                          },
                          "total": {
                            "type": "integer"
                          },
                          "firstAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "lastAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "silenceDays": {
                            "type": "number"
                          },
                          "medianGapDays": {
                            "anyOf": [
                              {
                                "type": "number",
                                "description": "호출 2회 미만이면 null"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/harness/brain": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "dir",
                    "docs",
                    "staleDays",
                    "stale",
                    "inbox",
                    "cadence"
                  ],
                  "properties": {
                    "dir": {
                      "type": "string"
                    },
                    "docs": {
                      "type": "object",
                      "required": [
                        "total",
                        "active",
                        "draft",
                        "superseded",
                        "other"
                      ],
                      "properties": {
                        "total": {
                          "type": "integer",
                          "description": "frontmatter가 있는 문서 수"
                        },
                        "active": {
                          "type": "integer"
                        },
                        "draft": {
                          "type": "integer"
                        },
                        "superseded": {
                          "type": "integer"
                        },
                        "other": {
                          "type": "integer",
                          "description": "status 값이 셋 중 어느 것도 아닌 문서"
                        }
                      }
                    },
                    "staleDays": {
                      "type": "integer"
                    },
                    "stale": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "path",
                          "kind",
                          "updated",
                          "ageDays"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "path": {
                            "type": "string"
                          },
                          "kind": {
                            "type": "string"
                          },
                          "updated": {
                            "type": "string",
                            "description": "frontmatter의 updated, YYYY-MM-DD"
                          },
                          "ageDays": {
                            "type": "integer"
                          }
                        }
                      },
                      "description": "active 인데 updated 가 60일 넘은 문서, 오래된 순"
                    },
                    "inbox": {
                      "type": "object",
                      "required": [
                        "items",
                        "undated",
                        "oldestAgeDays"
                      ],
                      "properties": {
                        "items": {
                          "type": "integer"
                        },
                        "undated": {
                          "type": "integer",
                          "description": "날짜 접두어가 없어 나이를 모르는 항목"
                        },
                        "oldestAgeDays": {
                          "anyOf": [
                            {
                              "type": "integer"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      }
                    },
                    "cadence": {
                      "type": "object",
                      "required": [
                        "weeks",
                        "julyBaselinePerWeek",
                        "last4WeeksPerWeek"
                      ],
                      "properties": {
                        "weeks": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": [
                              "week",
                              "commits"
                            ],
                            "properties": {
                              "week": {
                                "type": "string",
                                "description": "ISO 주, 예 2026-W36"
                              },
                              "commits": {
                                "type": "integer"
                              }
                            }
                          }
                        },
                        "julyBaselinePerWeek": {
                          "type": "number"
                        },
                        "last4WeeksPerWeek": {
                          "type": "number"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/decisions": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response",
