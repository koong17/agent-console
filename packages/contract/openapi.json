{
  "openapi": "3.0.3",
  "info": {
    "title": "agent-console",
    "version": "0.1.0"
  },
  "components": {
    "schemas": {}
  },
  "paths": {
    "/traces": {
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 100
            },
            "in": "query",
            "name": "limit",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "requestId",
                      "method",
                      "url",
                      "statusCode",
                      "durationMs",
                      "startedAt"
                    ],
                    "properties": {
                      "id": {
                        "type": "integer"
                      },
                      "requestId": {
                        "type": "string"
                      },
                      "method": {
                        "type": "string"
                      },
                      "url": {
                        "type": "string"
                      },
                      "statusCode": {
                        "type": "integer"
                      },
                      "durationMs": {
                        "type": "integer"
                      },
                      "startedAt": {
                        "type": "string",
                        "format": "date-time"
                      }
                    },
                    "title": "Trace"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/usage/repos": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "repo",
                      "sessions",
                      "turns",
                      "inputTokens",
                      "outputTokens",
                      "costUsd",
                      "lastSeenAt"
                    ],
                    "properties": {
                      "repo": {
                        "type": "string"
                      },
                      "sessions": {
                        "type": "integer"
                      },
                      "turns": {
                        "type": "integer"
                      },
                      "inputTokens": {
                        "type": "integer"
                      },
                      "outputTokens": {
                        "type": "integer"
                      },
                      "costUsd": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "lastSeenAt": {
                        "anyOf": [
                          {
                            "type": "string",
                            "format": "date-time"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/usage/daily": {
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365,
              "default": 30
            },
            "in": "query",
            "name": "days",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "day",
                      "sessions",
                      "turns",
                      "outputTokens",
                      "costUsd"
                    ],
                    "properties": {
                      "day": {
                        "type": "string",
                        "description": "YYYY-MM-DD, Asia/Seoul"
                      },
                      "sessions": {
                        "type": "integer"
                      },
                      "turns": {
                        "type": "integer"
                      },
                      "outputTokens": {
                        "type": "integer"
                      },
                      "costUsd": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/usage/gates": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "nudged",
                    "complied",
                    "rate",
                    "events"
                  ],
                  "properties": {
                    "nudged": {
                      "type": "integer"
                    },
                    "complied": {
                      "type": "integer"
                    },
                    "rate": {
                      "anyOf": [
                        {
                          "type": "number",
                          "description": "0..1, nudged가 0이면 null"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "events": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "sessionId",
                          "repo",
                          "ts",
                          "triggerSkill",
                          "outcome",
                          "complied"
                        ],
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "sessionId": {
                            "type": "string"
                          },
                          "repo": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "ts": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "triggerSkill": {
                            "type": "string"
                          },
                          "outcome": {
                            "anyOf": [
                              {
                                "type": "string",
                                "enum": [
                                  "nudged"
                                ]
                              },
                              {
                                "type": "string",
                                "enum": [
                                  "throttled"
                                ]
                              }
                            ]
                          },
                          "complied": {
                            "type": "boolean"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/usage/skills/weekly": {
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 52,
              "default": 8
            },
            "in": "query",
            "name": "weeks",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "weeks",
                    "rows"
                  ],
                  "properties": {
                    "weeks": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "description": "주 시작 월요일, YYYY-MM-DD, Asia/Seoul"
                      }
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "skill",
                          "counts",
                          "total"
                        ],
                        "properties": {
                          "skill": {
                            "type": "string"
                          },
                          "counts": {
                            "type": "array",
                            "items": {
                              "type": "integer"
                            },
                            "description": "weeks와 같은 길이, 같은 순서"
                          },
                          "total": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sessions": {
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "repo",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "repo",
                      "gitBranch",
                      "startedAt",
                      "lastSeenAt",
                      "turns",
                      "models",
                      "outputTokens",
                      "costUsd"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "repo": {
                        "type": "string"
                      },
                      "gitBranch": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "startedAt": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "lastSeenAt": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "turns": {
                        "type": "integer"
                      },
                      "models": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "outputTokens": {
                        "type": "integer"
                      },
                      "costUsd": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{id}": {
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "session",
                    "turns",
                    "totalCostUsd"
                  ],
                  "properties": {
                    "session": {
                      "type": "object",
                      "required": [
                        "id",
                        "cwd",
                        "repo",
                        "gitBranch",
                        "cliVersion",
                        "startedAt",
                        "lastSeenAt"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "cwd": {
                          "type": "string"
                        },
                        "repo": {
                          "type": "string"
                        },
                        "gitBranch": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "cliVersion": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "startedAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "lastSeenAt": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    },
                    "turns": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "ts",
                          "model",
                          "inputTokens",
                          "cacheReadTokens",
                          "cacheCreationTokens",
                          "outputTokens",
                          "costUsd"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "ts": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "model": {
                            "type": "string"
                          },
                          "inputTokens": {
                            "type": "integer"
                          },
                          "cacheReadTokens": {
                            "type": "integer"
                          },
                          "cacheCreationTokens": {
                            "type": "integer"
                          },
                          "outputTokens": {
                            "type": "integer"
                          },
                          "costUsd": {
                            "anyOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        }
                      }
                    },
                    "totalCostUsd": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ingest/status": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "current",
                    "recent"
                  ],
                  "properties": {
                    "current": {
                      "anyOf": [
                        {
                          "type": "object",
                          "required": [
                            "id",
                            "trigger",
                            "status",
                            "startedAt",
                            "finishedAt",
                            "files",
                            "turns",
                            "skills",
                            "gates",
                            "error"
                          ],
                          "properties": {
                            "id": {
                              "type": "integer"
                            },
                            "trigger": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "enum": [
                                    "startup"
                                  ]
                                },
                                {
                                  "type": "string",
                                  "enum": [
                                    "interval"
                                  ]
                                },
                                {
                                  "type": "string",
                                  "enum": [
                                    "manual"
                                  ]
                                }
                              ]
                            },
                            "status": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "enum": [
                                    "running"
                                  ]
                                },
                                {
                                  "type": "string",
                                  "enum": [
                                    "done"
                                  ]
                                },
                                {
                                  "type": "string",
                                  "enum": [
                                    "failed"
                                  ]
                                }
                              ]
                            },
                            "startedAt": {
                              "type": "string",
                              "format": "date-time"
                            },
                            "finishedAt": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "format": "date-time"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "files": {
                              "anyOf": [
                                {
                                  "type": "integer"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "turns": {
                              "anyOf": [
                                {
                                  "type": "integer"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "skills": {
                              "anyOf": [
                                {
                                  "type": "integer"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "gates": {
                              "anyOf": [
                                {
                                  "type": "integer"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "error": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            }
                          }
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "recent": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "trigger",
                          "status",
                          "startedAt",
                          "finishedAt",
                          "files",
                          "turns",
                          "skills",
                          "gates",
                          "error"
                        ],
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "trigger": {
                            "anyOf": [
                              {
                                "type": "string",
                                "enum": [
                                  "startup"
                                ]
                              },
                              {
                                "type": "string",
                                "enum": [
                                  "interval"
                                ]
                              },
                              {
                                "type": "string",
                                "enum": [
                                  "manual"
                                ]
                              }
                            ]
                          },
                          "status": {
                            "anyOf": [
                              {
                                "type": "string",
                                "enum": [
                                  "running"
                                ]
                              },
                              {
                                "type": "string",
                                "enum": [
                                  "done"
                                ]
                              },
                              {
                                "type": "string",
                                "enum": [
                                  "failed"
                                ]
                              }
                            ]
                          },
                          "startedAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "finishedAt": {
                            "anyOf": [
                              {
                                "type": "string",
                                "format": "date-time"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "files": {
                            "anyOf": [
                              {
                                "type": "integer"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "turns": {
                            "anyOf": [
                              {
                                "type": "integer"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "skills": {
                            "anyOf": [
                              {
                                "type": "integer"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "gates": {
                            "anyOf": [
                              {
                                "type": "integer"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "error": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ingest/run": {
      "post": {
        "responses": {
          "202": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "accepted"
                  ],
                  "properties": {
                    "accepted": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4000"
    }
  ]
}
