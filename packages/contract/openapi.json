                            "id",
                            "trigger",
                            "status",
                            "startedAt",
                            "finishedAt",
                            "files",
                            "turns",
                            "skills",
                            "gates",
                            "decisions",
                            "error"
                          ],
                          "properties": {
                            "id": {
                              "type": "integer"
                            },
                            "trigger": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "enum": [
                                    "startup"
                                  ]
                                },
                                {
                                  "type": "string",
                                  "enum": [
                                    "interval"
                                  ]
                                },
                                {
                                  "type": "string",
                                  "enum": [
                                    "manual"
                                  ]
                                }
                              ]
                            },
                            "status": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "enum": [
                                    "running"
                                  ]
                                },
                                {
                                  "type": "string",
                                  "enum": [
                                    "done"
                                  ]
                                },
                                {
                                  "type": "string",
                                  "enum": [
                                    "failed"
                                  ]
                                }
                              ]
                            },
                            "startedAt": {
                              "type": "string",
                              "format": "date-time"
                            },
                            "finishedAt": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "format": "date-time"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "files": {
                              "anyOf": [
                                {
                                  "type": "integer"
                                },
                                {
