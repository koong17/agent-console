                                "type": "null"
                              }
                            ]
                          },
                          "chosen": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "agreed": {
                            "anyOf": [
