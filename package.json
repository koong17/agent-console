{
  "name": "agent-console",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev:server": "pnpm --filter server dev",
    "dev:web": "pnpm --filter web dev",
    "contract": "pnpm --filter server openapi:emit && pnpm --filter @agent-console/contract generate",
    "format": "prettier --write \"apps/*/src/**/*.ts\" \"apps/web/app/**/*.{ts,tsx}\"",
    "contract:check": "sh scripts/contract-check.sh",
    "prepare": "git config core.hooksPath .githooks"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
